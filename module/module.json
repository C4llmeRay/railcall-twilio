    "network": [
      "api.twilio.com",
      "lookups.twilio.com",
      "verify.twilio.com",
      "pricing.twilio.com",
      "conversations.twilio.com",
      "studio.twilio.com",
      "messaging.twilio.com"
    ],
    "subprocess": false,
    "filesystem_writes": []
  },
