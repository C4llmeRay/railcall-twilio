    "provider": "twilio",
    "category": "messaging",
    "name": "Twilio",
    "required": [
      "account_sid",
      "auth_token"
    ],
    "optional": [
      "api_key_sid",
      "api_key_secret",
      "default_from",
      "messaging_service_sid",
